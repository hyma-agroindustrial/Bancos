# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO — CONTROL BANCOS (HYMA AGROINDUSTRIAL)
# Copia este archivo como '.env' para pruebas locales con nube o configúralas
# directamente en el panel de Environment Variables de Render.com
# ==============================================================================

# 1. BASE DE DATOS (PostgreSQL de Supabase o Neon.tech)
# Si se deja vacío o comentado en local, el sistema usa automáticamente sqlite:///./hyma_fiscal.db
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[TU-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# 2. SUPABASE STORAGE (Bóveda en la nube para Estados de Cuenta PDF y Logos)
# Obtén estos valores en: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. NOMBRES DE BUCKETS EN SUPABASE STORAGE (Se crean automáticamente)
SUPABASE_BUCKET_PDFS=estados-cuenta
SUPABASE_BUCKET_BRANDING=branding
